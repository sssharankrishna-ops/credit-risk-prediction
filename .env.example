# =====================================================================
# Environment template. Copy to ".env" before running anything:
#   Windows PowerShell:  Copy-Item .env.example .env
# NEVER commit the real .env file (it is in .gitignore).
# All ratios/thresholds are DECIMAL PROPORTIONS (20% -> 0.20).
# =====================================================================

# --- Application ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# --- Database (SQLite for the prototype; swap URL for Postgres later) ---
DATABASE_URL=sqlite:///./data/credit_risk.db

# --- Artifacts ---
MODEL_DIR=./models
MLFLOW_TRACKING_URI=./mlruns

# --- Risk classification thresholds (decimal proportions) ---
RISK_THRESHOLD_LOW=0.20
RISK_THRESHOLD_HIGH=0.50

# --- ECL assumption: Loss Given Default (decimal proportion) ---
# Regulatory LGD for unsecured retail exposures is often 45% (Basel IRB floor).
LGD=0.45

# --- Generative AI explanation ---
LLM_ENABLED=true
LLM_MODEL_NAME=distilgpt2
